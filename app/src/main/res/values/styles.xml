<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="YsDisplayMediumBlack22">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_main</item>
        <item name="android:textColor">@color/black_white_by_theme</item>
    </style>

    <style name="YsDisplayMedium14">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/update_track_text</item>
        <item name="android:textColor">@color/black_white_by_theme</item>
    </style>

    <style name="YsDisplayRegular13">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/description_track_text</item>
        <item name="android:textColor">@color/gray</item>
    </style>

    <style name="YsDisplayRegularBlack13">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/description_track_text</item>
        <item name="android:textColor">@color/black_white_by_theme</item>
    </style>

    <style name="YsDisplayMediumWhiteText">
        <item name="android:textColor">@color/mai_title_text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_main</item>
    </style>

    <style name="WhiteBigButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/big_button_background</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/big_button_text</item>
        <item name="android:textSize">@dimen/text_size_main</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="android:shadowColor">@android:color/transparent</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="iconTint">@color/big_button_text</item>
    </style>

    <style name="Toolbar" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_size_main</item>
        <item name="titleTextColor">@color/back_title</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="TitleText" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_size_main</item>
        <item name="titleTextColor">@color/back_title</item>
    </style>

    <style name="SettingsText">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:paddingVertical">21dp</item>
        <item name="android:textColor">@color/settings_text_row</item>
        <item name="android:textSize">@dimen/text_size_settings</item>
    </style>

    <style name="ImageSettings">
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundTintMode">multiply</item>
    </style>

    <style name="SearchInput">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/search_text</item>
        <item name="android:textColorHint">@color/search_input</item>
        <item name="android:textCursorDrawable">@drawable/cursor_color</item>
    </style>

    <style name="SearchHint">
        <item name="android:textSize">@dimen/text_search_hint</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/search_hint</item>
    </style>

    <style name="TrackName">
        <item name="android:textSize">@dimen/text_track_name</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/track_name</item>
    </style>

    <style name="ArtistName">
        <item name="android:textSize">@dimen/text_artist_name</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/artist_name</item>
    </style>

    <style name="YsDisplayMedium19">
        <item name="android:textSize">@dimen/sp_19</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/black_white_by_theme</item>
    </style>

    <style name="BlackButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/update_track_text</item>
        <item name="android:textColor">@color/white_black_by_theme</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/black_white_by_theme</item>
    </style>

    <style name="TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/black_library_text_theme</item>
        <item name="tabSelectedTextColor">@color/black_library_text_theme</item>
        <item name="tabTextColor">@color/black_library_text_theme</item>
        <item name="android:background">@color/with_library_text_theme</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>


    <style name="BottomNavigationTheme" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/background_color</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
    </style>

    <style name="InputTextField">
        <item name="android:textSize">@dimen/text_create_playlist</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/playlist_create_text</item>
        <item name="android:textColorHint">@color/playlist_create_text</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:lines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CreateButton" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/text_create_playlist</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="backgroundTint">@color/gray</item>
        <item name="shapeAppearance">@style/CustomButtonShape</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerSize">>8dp</item>
    </style>

    <style name="CustomButtonShape" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

</resources>
